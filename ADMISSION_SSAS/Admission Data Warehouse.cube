  <MdxScripts>
    <MdxScript dwd:design-time-name="44fa2108-d9b1-47ae-88e5-aab5d89f1782">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE MEMBER CURRENTCUBE.[Measures].Mean_Score_Mark
 AS [Measures].[SCORE MARK] / [Measures].[FACT CUTOFF SCORE Count], 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Max_Score_Mark
 AS MAX([DIM PROGRAM].[PROGRAM NAME].MEMBERS, [Measures].[SCORE MARK]), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].Min_Score_Mark
 AS MIN([DIM PROGRAM].[PROGRAM NAME].MEMBERS, [Measures].[SCORE MARK]), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>