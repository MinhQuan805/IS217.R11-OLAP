  <Source dwd:design-time-name="a5a9925b-6154-492d-a2a3-2b88c82b7ba5">
    <DataSourceViewID>Admission Data Warehouse</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="8bb6f9af-5ba8-41e1-9c52-eaa2d728693f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text> /*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;   
CREATE DYNAMIC SET CURRENTCUBE.[Major group - Major]
 AS GENERATE(
    [DIM MAJOR GROUP].[MAJOR GROUP NAME].[MAJOR GROUP NAME].MEMBERS,
    CROSSJOIN(
        [DIM MAJOR GROUP].[MAJOR GROUP NAME].CurrentMember,
        [DIM MAJOR].[MAJOR NAME].MEMBERS
    )
);                                         
CREATE MEMBER CURRENTCUBE.[Measures].[Mean SCORE MARK]
 AS [Measures].[SCORE MARK] / [Measures].[FACT CUTOFF SCORE Count], 
FORMAT_STRING = "Standard", 
VISIBLE = 1;                                    
CREATE MEMBER CURRENTCUBE.[Measures].[Diff SCORE MARK]
 AS [Measures].[Maximum SCORE MARK] - [Measures].[Minimum SCORE MARK], 
FORMAT_STRING = "Standard", 
VISIBLE = 1;                                      
CREATE MEMBER CURRENTCUBE.[Measures].[YoY Mean SCORE MARK]
 AS IIF(
    IsEmpty([Measures].[Mean SCORE MARK])
    OR IsEmpty(([Measures].[Mean SCORE MARK], [DIM YEAR].[YEAR].CurrentMember.PrevMember))
    OR ([Measures].[Mean SCORE MARK], [DIM YEAR].[YEAR].CurrentMember.PrevMember) = 0,
    NULL,
    (
        [Measures].[Mean SCORE MARK]
        - ([Measures].[Mean SCORE MARK], [DIM YEAR].[YEAR].CurrentMember.PrevMember)
    )
    / ([Measures].[Mean SCORE MARK], [DIM YEAR].[YEAR].CurrentMember.PrevMember)
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;          
CREATE MEMBER CURRENTCUBE.[Measures].[Score 2025]
 AS IIF(
    ISEMPTY( ([Measures].[FACT CUTOFF SCORE Count], [DIM YEAR].[YEAR].&amp;[2025]) ),
    NULL,
    ([Measures].[SCORE MARK], [DIM YEAR].[YEAR].&amp;[2025]) / ([Measures].[FACT CUTOFF SCORE Count], [DIM YEAR].[YEAR].&amp;[2025])
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1;          
CREATE MEMBER CURRENTCUBE.[Measures].[Score 2024]
 AS IIF(
    ISEMPTY( ([Measures].[FACT CUTOFF SCORE Count], [DIM YEAR].[YEAR].&amp;[2024]) ),
    NULL,
    ([Measures].[SCORE MARK], [DIM YEAR].[YEAR].&amp;[2024]) / ([Measures].[FACT CUTOFF SCORE Count], [DIM YEAR].[YEAR].&amp;[2024])
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1;          
CREATE MEMBER CURRENTCUBE.[Measures].[Diff 2025-2024]
 AS IIF(
    ISEMPTY([Measures].[Score 2025]) OR ISEMPTY([Measures].[Score 2024]),
    NULL,
    [Measures].[Score 2025] - [Measures].[Score 2024]
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1;          
CREATE DYNAMIC SET CURRENTCUBE.[Programs Up 2.5]
 AS ORDER(
    FILTER(
        [DIM PROGRAM].[SCHOOL NAME].[SCHOOL NAME].MEMBERS * [DIM PROGRAM].[PROGRAM NAME].[PROGRAM NAME].MEMBERS,
        NOT ISEMPTY([Measures].[Diff 2025-2024])
        AND [Measures].[Diff 2025-2024] &gt;= 2.5
    ),
    [Measures].[Diff 2025-2024],
    BDESC
);         
CREATE MEMBER CURRENTCUBE.[Measures].[Above 24 Count]
 AS SUM (
	EXISTING [FACT CUTOFF SCORE].[FACT ID].[FACT ID].MEMBERS,
	IIF ([Measures].[SCORE MARK] &gt;= 24, 1, 0)
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1;         
CREATE MEMBER CURRENTCUBE.[Measures].[Above 24 Ratio]
 AS IIF (
	[Measures].[FACT CUTOFF SCORE Count] &lt;= 0,
	0,
	[Measures].[Above 24 Count] / [Measures].[FACT CUTOFF SCORE Count]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1;       
CREATE MEMBER CURRENTCUBE.[Measures].[By Admission method Count]
 AS (
    [Measures].[FACT CUTOFF SCORE Count],
    [DIM ADMISSION METHOD].[ADMISSION METHOD NAME].[All]
), 
FORMAT_STRING = "Standard", 
VISIBLE = 1  ;  
CREATE DYNAMIC SET CURRENTCUBE.[School - Program above 24]
 AS FILTER(
    CROSSJOIN(
        [DIM SCHOOL].[SCHOOL NAME].[SCHOOL NAME].MEMBERS,
        [DIM PROGRAM].[PROGRAM NAME].[PROGRAM NAME].MEMBERS
    ),
    [Measures].[Mean SCORE MARK] &gt;= 24
);       
CREATE MEMBER CURRENTCUBE.[Measures].[By Admission method Ratio]
 AS -- Tỷ trọng (%) của từng phương thức so với tổng của năm đó
IIF(
    IsEmpty([Measures].[FACT CUTOFF SCORE Count]) OR [Measures].[By Admission method Count] = 0,
    NULL,
    [Measures].[FACT CUTOFF SCORE Count] / [Measures].[By Admission method Count]
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>