      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{B16FCCB3-B752-4082-B1E7-238D7AD21985}"
          SQLTask:SqlStatementSource="CREATE TABLE DIM_PROVINCE (&#xA;    PROVINCE_ID INT PRIMARY KEY,&#xA;    PROVINCE_NAME NVARCHAR(200) NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE DIM_SCHOOL (&#xA;    SCHOOL_ID NVARCHAR(50) PRIMARY KEY,&#xA;    SCHOOL_NAME NVARCHAR(500) NOT NULL,&#xA;    SCHOOL_TYPE NVARCHAR(100),&#xA;    SCHOOL_SHORT_NAME NVARCHAR(200),&#xA;    PROVINCE_ID INT,&#xA;    CONSTRAINT FK_SCHOOL_PROVINCE&#xA;        FOREIGN KEY (PROVINCE_ID)&#xA;        REFERENCES DIM_PROVINCE(PROVINCE_ID)&#xA;);&#xA;&#xA;CREATE TABLE DIM_MAJOR_GROUP (&#xA;    MAJOR_GROUP_ID INT PRIMARY KEY,&#xA;    MAJOR_GROUP_NAME NVARCHAR(500) NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE DIM_MAJOR (&#xA;    MAJOR_ID INT PRIMARY KEY,&#xA;    MAJOR_NAME NVARCHAR(500) NOT NULL,&#xA;    MAJOR_DESCRIPTION NVARCHAR(MAX)&#xA;);&#xA;&#xA;CREATE TABLE BRIDGE_MAJOR_GROUP (&#xA;    MAJOR_ID INT NOT NULL,&#xA;    MAJOR_GROUP_ID INT NOT NULL,&#xA;    PRIMARY KEY (MAJOR_ID, MAJOR_GROUP_ID),&#xA;    CONSTRAINT FK_BMG_MAJOR&#xA;        FOREIGN KEY (MAJOR_ID)&#xA;        REFERENCES DIM_MAJOR(MAJOR_ID),&#xA;    CONSTRAINT FK_BMG_GROUP&#xA;        FOREIGN KEY (MAJOR_GROUP_ID)&#xA;        REFERENCES DIM_MAJOR_GROUP(MAJOR_GROUP_ID)&#xA;);&#xA;&#xA;CREATE TABLE DIM_SCORE_BLOCK (&#xA;    SCORE_BLOCK_CODE NVARCHAR(50) PRIMARY KEY,&#xA;    SCORE_BLOCK_NAME NVARCHAR(500)&#xA;);&#xA;&#xA;CREATE TABLE DIM_SUBJECT (&#xA;    SUBJECT_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    SUBJECT_NAME NVARCHAR(200) NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE BRIDGE_SCORE_BLOCK_SUBJECT (&#xA;    SCORE_BLOCK_CODE NVARCHAR(50) NOT NULL,&#xA;    SUBJECT_ID INT NOT NULL,&#xA;    PRIMARY KEY (SCORE_BLOCK_CODE, SUBJECT_ID),&#xA;    CONSTRAINT FK_BSBS_BLOCK&#xA;        FOREIGN KEY (SCORE_BLOCK_CODE)&#xA;        REFERENCES DIM_SCORE_BLOCK(SCORE_BLOCK_CODE),&#xA;    CONSTRAINT FK_BSBS_SUBJECT&#xA;        FOREIGN KEY (SUBJECT_ID)&#xA;        REFERENCES DIM_SUBJECT(SUBJECT_ID)&#xA;);&#xA;&#xA;CREATE TABLE DIM_ADMISSION_METHOD (&#xA;    ADMISSION_METHOD_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    ADMISSION_METHOD_NAME NVARCHAR(300) NOT NULL&#xA;);&#xA;&#xA;CREATE TABLE DIM_YEAR (&#xA;    YEAR_ID INT PRIMARY KEY,&#xA;    YEAR INT NOT NULL,&#xA;    DECADE NVARCHAR(50)&#xA;);&#xA;&#xA;CREATE TABLE DIM_PROGRAM (&#xA;    PROGRAM_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    SCHOOL_ID NVARCHAR(50) NOT NULL,&#xA;    MAJOR_ID INT,&#xA;    SCORE_CODE NVARCHAR(100),&#xA;    PROGRAM_NAME NVARCHAR(1000),&#xA;    CONSTRAINT FK_PROGRAM_SCHOOL&#xA;        FOREIGN KEY (SCHOOL_ID)&#xA;        REFERENCES DIM_SCHOOL(SCHOOL_ID),&#xA;    CONSTRAINT FK_PROGRAM_MAJOR&#xA;        FOREIGN KEY (MAJOR_ID)&#xA;        REFERENCES DIM_MAJOR(MAJOR_ID)&#xA;);&#xA;&#xA;CREATE TABLE FACT_CUTOFF_SCORE (&#xA;    FACT_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    PROGRAM_ID INT NOT NULL,&#xA;    YEAR_ID INT NOT NULL,&#xA;    ADMISSION_METHOD_ID INT NOT NULL,&#xA;    SCORE_CONVERTED_MARK DECIMAL(9,4),&#xA;&#xA;    CONSTRAINT FK_FACT_PROGRAM&#xA;        FOREIGN KEY (PROGRAM_ID)&#xA;        REFERENCES DIM_PROGRAM(PROGRAM_ID),&#xA;&#xA;    CONSTRAINT FK_FACT_YEAR&#xA;        FOREIGN KEY (YEAR_ID)&#xA;        REFERENCES DIM_YEAR(YEAR_ID),&#xA;&#xA;    CONSTRAINT FK_FACT_METHOD&#xA;        FOREIGN KEY (ADMISSION_METHOD_ID)&#xA;        REFERENCES DIM_ADMISSION_METHOD(ADMISSION_METHOD_ID)&#xA;);&#xA;&#xA;CREATE TABLE BRIDGE_FACT_SCORE_BLOCK (&#xA;    FACT_ID INT NOT NULL,&#xA;    SCORE_BLOCK_CODE NVARCHAR(50) NOT NULL,&#xA;    PRIMARY KEY (FACT_ID, SCORE_BLOCK_CODE),&#xA;&#xA;    CONSTRAINT FK_BFSB_FACT&#xA;        FOREIGN KEY (FACT_ID)&#xA;        REFERENCES FACT_CUTOFF_SCORE(FACT_ID),&#xA;&#xA;    CONSTRAINT FK_BFSB_BLOCK&#xA;        FOREIGN KEY (SCORE_BLOCK_CODE)&#xA;        REFERENCES DIM_SCORE_BLOCK(SCORE_BLOCK_CODE)&#xA;);&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
